# Copy to .env and fill in. Never commit .env.
# SEC requires a descriptive User-Agent: "Name email@example.com"
SEC_USER_AGENT="Your Name your.email@example.com"
VOYAGE_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=postgresql://finrag:finrag@localhost:5432/finrag
# Which watchlist to use: config/demo.yaml (public) or config/holdings.yaml (private)
WATCHLIST_PATH=config/demo.yaml
# Embeddings: "local" (Qwen3-Embedding on this machine, free) or "voyage" (API)
# EMBED_PROVIDER=local
# Optional Voyage overrides
# VOYAGE_MODEL=voyage-4
# EMBED_BUDGET_TOKENS=150000000
# Voyage accounts WITHOUT a payment method are limited to 3 requests and 10K
# tokens per minute. Uncomment both to work within that (slow: ~13h full load):
# VOYAGE_MAX_BATCH_TOKENS=8000
# VOYAGE_RPM=3
